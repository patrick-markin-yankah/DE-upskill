model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull
	cultureInfo en-US
	annotation __PBI_TimeIntelligenceEnabled = 0
	annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table FactAttendance
ref table ClassDay
ref table FactAssessment
ref table FactOutcome
ref table DimLearner
ref table FactParticipation
ref table DimCohort
ref table DimTrack
ref table DimWeek
ref table DimDate
ref table AsOfWeek
ref table WeekWindow
ref table TrackWeek
ref table FactException
ref table _Measures
ref table SecurityUsers

ref role Director
ref role Trainer
ref role Student
