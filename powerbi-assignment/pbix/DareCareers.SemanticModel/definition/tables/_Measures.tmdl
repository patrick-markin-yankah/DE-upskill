	measure 'Attendance Flags' = COUNTROWS ( FILTER ( DimLearner, [Flag Shape] = "Attendance" ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: 3954af32-9401-4419-9cfc-e298df0bc2cc

	measure 'Assessment Flags' = COUNTROWS ( FILTER ( DimLearner, [Flag Shape] = "Assessment" ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: 7b7bba63-d3c7-482d-b218-2ebf93c6286f

	measure 'Both Flags' = COUNTROWS ( FILTER ( DimLearner, [Flag Shape] = "Both" ) )
		formatString: #,0
		displayFolder: Monday
