	measure 'Unmatched Names' =
			CALCULATE (
			    COUNTROWS ( FactException ),
			    FactException[Feed] = "Participation",
			    FactException[Detail] = "Participation name matched no learner"
			)
		formatString: #,0
		displayFolder: Monday
		lineageTag: 46a4a95d-85f3-41c6-b024-7ab2f6a76ca6

	measure 'Quiz Against Track' =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR TrackMedian =
			    CALCULATE (
			        MAX ( TrackWeek[MedianQuiz] ),
			        TREATAS ( VALUES ( DimLearner[CohortKey] ), TrackWeek[CohortKey] ),
			        TREATAS ( VALUES ( DimLearner[TrackKey] ), TrackWeek[TrackKey] ),
			        TrackWeek[WeekNumber] = AsOfWeekNumber
			    )
			RETURN
			    [Quiz This Week] - TrackMedian
		formatString: 0.0
		displayFolder: Monday
		lineageTag: 261107d3-f739-4d79-85af-86bed2bda582

	measure 'Attendance Rate Graduates' =
			CALCULATE (
			    [Attendance Rate],
			    FILTER ( DimLearner, CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = TRUE () )
			)
		formatString: 0.0%
