	measure 'Participated Only' = COUNTROWS ( FILTER ( DimLearner, [Attended This Week] = 0 && [Participated This Week] > 0 ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: e70e59d3-ec1a-406f-8321-b5e545233879

	measure 'Neither Attendance Nor Participation' = COUNTROWS ( FILTER ( DimLearner, [Attended This Week] = 0 && [Participated This Week] = 0 ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: f62e90bf-258e-4ade-9f36-fc970a400c5c

	measure 'Quiz This Week' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        AVERAGE ( FactAssessment[Score] ),
			        FactAssessment[Assessment] = "Quiz",
			        FactAssessment[WeekNumber] = AsOfWeekNumber
			    )
		formatString: 0.0
		displayFolder: Monday
		lineageTag: ab2897e4-15ca-462f-8019-3b2770f3f332

	measure 'Lab This Week' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        AVERAGE ( FactAssessment[Score] ),
			        FactAssessment[Assessment] = "Lab",
			        FactAssessment[WeekNumber] = AsOfWeekNumber
			    )
		formatString: 0.0
		displayFolder: Monday
		lineageTag: 8d5f5658-c9ee-4223-ad1e-8c2261e21fb7

	measure 'Share Below Quiz Bar' =
			DIVIDE (
			    COUNTROWS ( FILTER ( DimLearner, NOT ISBLANK ( [Quiz This Week] ) && [Quiz This Week] < [Score Bar] ) ),
			    [Learners]
			)
		formatString: 0.0%
		displayFolder: Monday
		lineageTag: 953a6096-9404-481a-ba57-304f1f9ea8d9

	measure 'Share Blank Lab' =
			DIVIDE (
			    COUNTROWS ( FILTER ( DimLearner, ISBLANK ( [Lab This Week] ) ) ),
			    [Learners]
			)
		formatString: 0.0%
		displayFolder: Monday
		lineageTag: 05ad2167-dad5-428e-b6bc-8970dc32e302

	measure 'Learner Track' =
			LOOKUPVALUE (
			    DimTrack[TrackName],
			    DimTrack[TrackKey],
			    SELECTEDVALUE ( DimLearner[TrackKey] )
			)
		displayFolder: Monday
		lineageTag: 7c4e1a92-6b38-4f05-9d71-2e8a0c5b6d14

	measure Engagement =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR EverAttended = [Days Attended]
			VAR EarlyWeeks =
			    CALCULATE (
			        DISTINCTCOUNT ( FactAttendance[ClassDate] ),
			        FactAttendance[Attended] = TRUE (),
			        FactAttendance[WeekNumber] <= 2
			    )
			VAR ThisWeek =
			    CALCULATE (
			        DISTINCTCOUNT ( FactAttendance[ClassDate] ),
			        FactAttendance[Attended] = TRUE (),
			        FactAttendance[WeekNumber] = AsOfWeekNumber
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        EverAttended = 0, "Never started",
			        AsOfWeekNumber > 2 && EarlyWeeks > 0 && ThisWeek = 0, "Faded",
			        "Active"
			    )
		displayFolder: Monday
		lineageTag: ba9db98c-df2e-43e1-9025-9c37c3ddd57e

	measure 'Learner Flag' =
			IF (
			    ISINSCOPE ( DimLearner[DisplayName] ),
			    [At Risk],
			    [At Risk Count]
			)
		formatString: #,0
		displayFolder: Monday
