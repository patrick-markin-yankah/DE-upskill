	measure 'Learner Flag Label' =
			IF (
			    NOT ISINSCOPE ( DimLearner[DisplayName] ),
			    BLANK (),
			    IF ( [At Risk] = 1, "Flagged", "None" )
			)
		displayFolder: Monday
		lineageTag: c9e5a3b6-7d40-4122-ae38-4f1b2c6d9e53

	measure 'Learner Flag Color' =
			IF (
			    NOT ISINSCOPE ( DimLearner[DisplayName] ),
			    BLANK (),
