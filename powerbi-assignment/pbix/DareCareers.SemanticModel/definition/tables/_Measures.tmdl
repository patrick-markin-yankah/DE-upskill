table _Measures
	lineageTag: aada50e2-f9b6-4ffe-be7c-28dcbd226472

	measure 'As Of Week Number' =
			VAR SelectedWeek = SELECTEDVALUE ( AsOfWeek[WeekNumber] )
			RETURN
			    IF (
			        ISBLANK ( SelectedWeek ),
			        MAXX ( ALL ( AsOfWeek ), AsOfWeek[WeekNumber] ),
			        SelectedWeek
			    )
		formatString: 0
		displayFolder: As-of
		lineageTag: 9a65f596-a821-4c92-9fc0-813dd04f0a24

	measure 'Expected Days' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( ClassDay[ClassDate] ),
			        TREATAS ( VALUES ( DimLearner[CohortKey] ), ClassDay[CohortKey] ),
			        TREATAS ( VALUES ( DimLearner[TrackKey] ), ClassDay[TrackKey] ),
			        ClassDay[WeekNumber] <= AsOfWeekNumber,
			        REMOVEFILTERS ( DimLearner[Email] ),
			        REMOVEFILTERS ( DimLearner[DisplayName] ),
			        REMOVEFILTERS ( DimLearner[NameKey] )
			    )
		formatString: #,0
		displayFolder: Activity
		lineageTag: d61baa39-c95c-4b2c-87aa-1f579b178ded

	measure 'Days Attended' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactAttendance[ClassDate] ),
			        FactAttendance[Attended] = TRUE (),
			        FactAttendance[WeekNumber] <= AsOfWeekNumber
			    )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 45218344-9c5b-459f-b1a4-3dc98b3b8903

	measure 'Attendance Rate' =
			DIVIDE (
			    SUMX ( DimLearner, [Days Attended] ),
			    SUMX ( DimLearner, [Expected Days] )
			)
		formatString: 0.0%
		displayFolder: Activity
		lineageTag: 8ca2fd24-d8fc-4c75-8406-8dcb73d0c645

	measure 'Days Participated' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactParticipation[ClassDate] ),
			        FactParticipation[WeekNumber] <= AsOfWeekNumber
			    )
		formatString: #,0
		displayFolder: Activity
		lineageTag: edb847b5-5247-49af-87e9-95f369a40e66

	measure 'Participation Rate' =
			DIVIDE (
			    SUMX ( DimLearner, [Days Participated] ),
			    SUMX ( DimLearner, [Expected Days] )
			)
		formatString: 0.0%
		displayFolder: Activity
		lineageTag: 7c46575a-5913-4b4d-a297-d3cfa72af715

	measure 'Average Lab' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        AVERAGE ( FactAssessment[Score] ),
			        FactAssessment[Assessment] = "Lab",
			        FactAssessment[WeekNumber] <= AsOfWeekNumber
			    )
		formatString: 0.0
		displayFolder: Activity
		lineageTag: 9cfa0e0b-2222-4b27-a8f5-742467243059

	measure 'Average Quiz' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        AVERAGE ( FactAssessment[Score] ),
			        FactAssessment[Assessment] = "Quiz",
			        FactAssessment[WeekNumber] <= AsOfWeekNumber
			    )
		formatString: 0.0
		displayFolder: Activity
		lineageTag: fdffc633-d975-4baa-8f76-d906ed6b180c

	measure 'Missed Assessments' =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR Weeks =
			    CALCULATETABLE (
			        SUMMARIZE ( FactAssessment, FactAssessment[Assessment], FactAssessment[WeekNumber] ),
			        REMOVEFILTERS ( DimLearner ),
			        FactAssessment[WeekNumber] <= AsOfWeekNumber
			    )
			VAR Submitted =
			    CALCULATETABLE (
			        SUMMARIZE ( FactAssessment, FactAssessment[Assessment], FactAssessment[WeekNumber] ),
			        FactAssessment[WeekNumber] <= AsOfWeekNumber,
			        NOT ISBLANK ( FactAssessment[Score] )
			    )
			RETURN
			    COUNTROWS ( Weeks ) - COUNTROWS ( Submitted )
		formatString: #,0
		displayFolder: Activity
		lineageTag: d51a5a34-4793-4d95-8024-13b88ad36b54

	measure Learners =
			CALCULATE (
			    DISTINCTCOUNT ( DimLearner[Email] ),
			    TREATAS ( VALUES ( DimCohort[CohortKey] ), DimLearner[CohortKey] ),
			    TREATAS ( VALUES ( DimTrack[TrackKey] ), DimLearner[TrackKey] )
			)
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: 207fcd78-04cd-426d-a073-da8b829defad

	measure Graduates = CALCULATE ( DISTINCTCOUNT ( FactOutcome[Email] ), FactOutcome[Graduated] = TRUE () )
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: 8425dd52-39d3-4424-88c9-18e872c9b17a

	measure Non-Graduates = CALCULATE ( DISTINCTCOUNT ( FactOutcome[Email] ), FactOutcome[Graduated] = FALSE () )
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: 41fd41b1-b637-45af-8409-24fe50b39168

	measure 'Certified Learners' = CALCULATE ( DISTINCTCOUNT ( FactOutcome[Email] ), FactOutcome[Certified] = TRUE () )
		formatString: #,0
		displayFolder: Outcomes
		lineageTag: 532bc7de-df61-4868-9c27-0b355e44a451

	measure 'Graduation Rate' = DIVIDE ( [Graduates], [Learners] )
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: c1a90159-7e80-4fd8-8049-8af7e22ddd08

	measure 'Non-Graduation Rate' = DIVIDE ( [Non-Graduates], [Learners] )
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: 9c1c9751-9b6e-4f63-b6dd-db66da02c497

	measure 'Certification Rate' = DIVIDE ( [Certified Learners], [Learners] )
		formatString: 0.0%
		displayFolder: Outcomes
		lineageTag: 58e98def-8284-4aad-ad4e-a60af25af532

	measure 'Attendance Bar' = 0.6
		formatString: 0.0%
		displayFolder: Monday
		lineageTag: 740ecdea-0f13-4c9d-b3e3-2dc252af5471

	measure 'Score Bar' = 50
		formatString: 0
		displayFolder: Monday
		lineageTag: 93c304f8-104b-4a65-a7dc-958a955cffb9

	measure 'Low Score Bar' = 30
		formatString: 0
		displayFolder: Monday
		lineageTag: 4c8a1e2b-7d6f-4a91-9c33-2b8e5f0a1d47

	measure 'At Risk' =
			VAR ThinAttendance = NOT ISBLANK ( [Attendance Rate] ) && [Attendance Rate] < [Attendance Bar]
			VAR WeakLab = NOT ISBLANK ( [Average Lab] ) && [Average Lab] < [Score Bar]
			VAR WeakQuiz = NOT ISBLANK ( [Average Quiz] ) && [Average Quiz] < [Score Bar]
			VAR InScope = NOT ISBLANK ( [Expected Days] ) && [Expected Days] > 0
			RETURN
			    IF ( ( InScope && ThinAttendance ) || ( WeakLab && WeakQuiz ), 1, 0 )
		formatString: 0
		displayFolder: Monday
		lineageTag: 1cef6283-7b3f-4c05-9bd5-564805b6a249

	measure 'At Risk Count' = SUMX ( DimLearner, [At Risk] )
		formatString: #,0
		displayFolder: Monday
		lineageTag: b73ce883-9e63-41e1-b1aa-f5a6a8c57bc3

	measure 'To Call' = COUNTROWS ( FILTER ( DimLearner, [First Call Candidate] = 1 ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: 6a1d8e44-2c7b-4f19-8a55-0d9e3b7c1f28

	measure 'Flag Reason' =
			VAR AttendedDays = [Days Attended]
			VAR Expected = [Expected Days]
			VAR ParticipatedDays = [Days Participated]
			VAR LabScore = [Average Lab]
			VAR QuizScore = [Average Quiz]
			VAR LabNow = [Lab This Week]
			VAR QuizNow = [Quiz This Week]
			VAR WeakLab = NOT ISBLANK ( LabScore ) && LabScore < [Score Bar]
			VAR WeakQuiz = NOT ISBLANK ( QuizScore ) && QuizScore < [Score Bar]
			VAR OneMean = WeakLab || WeakQuiz
			VAR BothMeans = WeakLab && WeakQuiz
			VAR ThinAttendance = NOT ISBLANK ( [Attendance Rate] ) && [Attendance Rate] < [Attendance Bar]
			VAR Because =
			    SWITCH (
			        TRUE (),
			        WeakLab && WeakQuiz, "mean lab and quiz are under 50",
			        WeakLab, "mean lab is under 50",
			        WeakQuiz, "mean quiz is under 50",
			        "the means are not under 50"
			    )
			VAR InScope = NOT ISBLANK ( Expected ) && Expected > 0
			VAR Opening =
			    SWITCH (
			        TRUE (),
			        InScope && ThinAttendance && OneMean, "Attendance is under 60% and " & Because & ". ",
			        InScope && ThinAttendance, "Attendance is under 60%. ",
			        BothMeans, "The mean lab and quiz are under 50. ",
			        "Not flagged. "
			    )
			RETURN
			    Opening
			        & "Attended " & AttendedDays & " of " & Expected
			        & " days, participated " & ParticipatedDays
			        & ", average lab " & FORMAT ( LabScore, "0" )
			        & ", average quiz " & FORMAT ( QuizScore, "0" )
			        & ", lab this week " & FORMAT ( LabNow, "0" )
			        & ", quiz this week " & FORMAT ( QuizNow, "0" )
			        & "."
		displayFolder: Monday
		lineageTag: 3d54d1d7-b7ec-45c7-a330-06bf7c3e68cf

	measure 'Flagged Non-Graduates' =
			COUNTROWS (
			    FILTER (
			        DimLearner,
			        [At Risk] = 1
			            && CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = FALSE ()
			    )
			)
		formatString: #,0
		displayFolder: Back-test
		lineageTag: 7c1d9296-8c10-41db-bb46-e6d9baadce7e

	measure 'Missed Non-Graduates' =
			COUNTROWS (
			    FILTER (
			        DimLearner,
			        [At Risk] = 0
			            && CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = FALSE ()
			    )
			)
		formatString: #,0
		displayFolder: Back-test
		lineageTag: f96f5dbb-3d45-4ca9-ace0-1a8384c635eb

	measure 'Attendance Rate Gap' =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR ThisWeek = SELECTEDVALUE ( DimWeek[WeekNumber] )
			VAR ThisRate = [Attendance Rate]
			VAR OtherRate =
			    CALCULATE (
			        [Attendance Rate],
			        DimWeek[WeekNumber] <= AsOfWeekNumber,
			        DimWeek[WeekNumber] <> ThisWeek
			    )
			RETURN
			    IF (
			        ISBLANK ( ThisWeek )
			            || ThisWeek > AsOfWeekNumber
			            || ISBLANK ( ThisRate )
			            || ISBLANK ( OtherRate ),
			        BLANK (),
			        ThisRate - OtherRate
			    )
		formatString: 0.0%
		displayFolder: Activity
		lineageTag: d56174b0-34df-4732-8e09-b7b27fa967d9

	measure 'Quiz Average Gap' =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR ThisWeek = SELECTEDVALUE ( DimWeek[WeekNumber] )
			VAR ThisQuiz = [Average Quiz]
			VAR OtherQuiz =
			    CALCULATE (
			        [Average Quiz],
			        DimWeek[WeekNumber] <= AsOfWeekNumber,
			        DimWeek[WeekNumber] <> ThisWeek
			    )
			RETURN
			    IF (
			        ISBLANK ( ThisWeek )
			            || ThisWeek > AsOfWeekNumber
			            || ISBLANK ( ThisQuiz )
			            || ISBLANK ( OtherQuiz ),
			        BLANK (),
			        ThisQuiz - OtherQuiz
			    )
		formatString: 0.0
		displayFolder: Activity
		lineageTag: 051c6e3d-103c-4d86-bc13-03a5866b56c0

	measure 'Unusual Week' =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR ThisWeek = SELECTEDVALUE ( DimWeek[WeekNumber] )
			VAR AttendanceGap = 0.15
			VAR QuizGap = 10
			RETURN
			    IF (
			        ISBLANK ( ThisWeek ) || ThisWeek > AsOfWeekNumber,
			        0,
			        IF (
			            (
			                NOT ISBLANK ( [Attendance Rate Gap] )
			                    && [Attendance Rate Gap] < -AttendanceGap
			            )
			                || (
			                    NOT ISBLANK ( [Quiz Average Gap] )
			                        && [Quiz Average Gap] < -QuizGap
			                ),
			            1,
			            0
			        )
			    )
		formatString: 0
		displayFolder: Activity
		lineageTag: f67936e1-5dd3-4402-ab22-21614f31f53b

	measure 'Quiz Gap Ink' =
			IF ( NOT ISBLANK ( [Quiz Average Gap] ) && [Quiz Average Gap] < 0, "#8C3A32", "#1C2430" )
		displayFolder: Activity
		lineageTag: b1c2d3e4-5f60-4711-a829-0c1d2e3f4a5b

	measure 'Attendance Gap Ink' =
			IF ( NOT ISBLANK ( [Attendance Rate Gap] ) && [Attendance Rate Gap] < 0, "#8C3A32", "#1C2430" )
		displayFolder: Activity
		lineageTag: c2d3e4f5-6071-4822-b93a-1d2e3f405b6c

	measure 'At Risk Prior Week' =
			VAR PriorWeek = [As Of Week Number] - 1
			RETURN
			    IF ( PriorWeek < 1, 0, CALCULATE ( [At Risk], AsOfWeek[WeekNumber] = PriorWeek ) )
		formatString: 0
		displayFolder: Monday
		lineageTag: c2b180d9-8d8f-401c-8753-59a64248dbca

	measure 'Flag Change' =
			SWITCH (
			    TRUE (),
			    [At Risk] = 1 && [At Risk Prior Week] = 0, "New",
			    [At Risk] = 1 && [At Risk Prior Week] = 1, "Still flagged",
			    [At Risk] = 0 && [At Risk Prior Week] = 1, "Cleared",
			    "Clear"
			)
		displayFolder: Monday
		lineageTag: af99a694-c0ff-4f58-922c-18213fe96cd7

	measure 'New Flags' = COUNTROWS ( FILTER ( DimLearner, [Flag Change] = "New" ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: deb9e235-7ab7-4e5d-becb-4b5d3bae6d52

	measure 'Still Flagged' = COUNTROWS ( FILTER ( DimLearner, [Flag Change] = "Still flagged" ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: cf5dc54f-1c07-40f6-be5e-7e363a9707a7

	measure 'Cleared Flags' = COUNTROWS ( FILTER ( DimLearner, [Flag Change] = "Cleared" ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: 6e21d0c7-e4aa-4a79-9454-82f13a1058c6

	measure 'On Both Parts' =
			VAR ThinAttendance = NOT ISBLANK ( [Attendance Rate] ) && [Attendance Rate] < [Attendance Bar]
			VAR WeakMeans =
			    ( NOT ISBLANK ( [Average Lab] ) && [Average Lab] < [Score Bar] )
			        || ( NOT ISBLANK ( [Average Quiz] ) && [Average Quiz] < [Score Bar] )
			VAR InScope = NOT ISBLANK ( [Expected Days] ) && [Expected Days] > 0
			RETURN
			    IF ( InScope && ThinAttendance && WeakMeans, 1, 0 )
		formatString: 0
		displayFolder: Monday
		lineageTag: 6e2b9c14-8a47-4d15-b6c0-91f3a7e25c80

	measure 'Low Score This Week' =
			VAR LabScore = [Lab This Week]
			VAR QuizScore = [Quiz This Week]
			RETURN
			    IF (
			        ( NOT ISBLANK ( LabScore ) && LabScore < [Low Score Bar] )
			            || ( NOT ISBLANK ( QuizScore ) && QuizScore < [Low Score Bar] ),
			        1,
			        0
			    )
		formatString: 0
		displayFolder: Monday
		lineageTag: 9a1d4f70-2c58-4e6b-a813-5d7c0b9e3f21

	measure 'First Call Candidate' =
			VAR AsOfWeekNumber = [As Of Week Number]
			VAR ThinAttendance = NOT ISBLANK ( [Attendance Rate] ) && [Attendance Rate] < [Attendance Bar]
			VAR WeakLab = NOT ISBLANK ( [Average Lab] ) && [Average Lab] < [Score Bar]
			VAR WeakQuiz = NOT ISBLANK ( [Average Quiz] ) && [Average Quiz] < [Score Bar]
			VAR InScope = NOT ISBLANK ( [Expected Days] ) && [Expected Days] > 0
			RETURN
			    IF (
			        AsOfWeekNumber >= 4
			            && InScope
			            && ThinAttendance
			            && ( WeakLab || WeakQuiz ),
			        1,
			        0
			    )
		formatString: 0
		displayFolder: Monday
		lineageTag: c4e8a1b2-6f30-4d9a-8c71-2b5e9a0d4f16

	measure Severity =
			IF (
			    [At Risk] = 1 || [First Call Candidate] = 1,
			    [Missed Assessments] + ( 1 - IF ( ISBLANK ( [Attendance Rate] ), 0, [Attendance Rate] ) ),
			    BLANK ()
			)
		formatString: 0.00
		displayFolder: Monday
		lineageTag: 2719acdf-f104-4596-9382-a0cb736f735f

	measure 'Call Rank' =
			IF (
			    [First Call Candidate] = 1,
			    VAR CurrentEmail = MAX ( DimLearner[Email] )
			    VAR RankRows =
			        FILTER (
			            ADDCOLUMNS (
			                SUMMARIZE ( ALLSELECTED ( DimLearner ), DimLearner[Email] ),
			                "@Score",
			                    IF (
			                        [First Call Candidate] = 1,
			                        [Missed Assessments]
			                            + ( 1 - IF ( ISBLANK ( [Attendance Rate] ), 0, [Attendance Rate] ) )
			                            + DIVIDE (
			                                RANKX (
			                                    ALL ( DimLearner[Email] ),
			                                    DimLearner[Email],
			                                    MAX ( DimLearner[Email] ),
			                                    ASC
			                                ),
			                                1000000
			                            )
			                    )
			            ),
			            NOT ISBLANK ( [@Score] )
			        )
			    VAR CurrentScore =
			        MAXX ( FILTER ( RankRows, DimLearner[Email] = CurrentEmail ), [@Score] )
			    RETURN
			        RANKX ( RankRows, [@Score], CurrentScore, DESC, SKIP )
			)
		formatString: 0
		displayFolder: Monday
		lineageTag: 8b1c0a43-2fcc-40e4-afad-2fcc98ed314d

	measure 'On First Call List' = IF ( [First Call Candidate] = 1, 1, 0 )
		formatString: 0
		displayFolder: Monday
		lineageTag: 3fdb7d85-9cad-4636-8810-e870cdfdfa6b

	measure 'Flag Shape' =
			VAR ThinAttendance = NOT ISBLANK ( [Attendance Rate] ) && [Attendance Rate] < [Attendance Bar]
			VAR WeakLab = NOT ISBLANK ( [Average Lab] ) && [Average Lab] < [Score Bar]
			VAR WeakQuiz = NOT ISBLANK ( [Average Quiz] ) && [Average Quiz] < [Score Bar]
			VAR InScope = NOT ISBLANK ( [Expected Days] ) && [Expected Days] > 0
			RETURN
			    SWITCH (
			        TRUE (),
			        InScope && ThinAttendance && ( WeakLab || WeakQuiz ), "Both",
			        InScope && ThinAttendance, "Attendance",
			        WeakLab && WeakQuiz, "Assessment",
			        BLANK ()
			    )
		displayFolder: Monday
		lineageTag: 15f1365d-f9a7-42de-acad-79813af46c11

	measure 'Attended This Week' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactAttendance[ClassDate] ),
			        FactAttendance[Attended] = TRUE (),
			        FactAttendance[WeekNumber] = AsOfWeekNumber
			    )
		formatString: #,0
		displayFolder: Monday
		lineageTag: b6d62904-b937-4cde-b805-783c6eaf6d44

	measure 'Participated This Week' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactParticipation[ClassDate] ),
			        FactParticipation[WeekNumber] = AsOfWeekNumber
			    )
		formatString: #,0
		displayFolder: Monday
		lineageTag: ab814d66-88cd-49bd-a5d5-f30be8d2c74c

	measure 'Attended And Participated' = COUNTROWS ( FILTER ( DimLearner, [Attended This Week] > 0 && [Participated This Week] > 0 ) )
		formatString: #,0
		displayFolder: Monday
		lineageTag: c36ca629-dc92-4232-9183-0c99dcbc45d7

	measure 'Attended Only' = COUNTROWS ( FILTER ( DimLearner, [Attended This Week] > 0 && [Participated This Week] = 0 ) )
		formatString: #,0
		displayFolder: Monday
