	measure 'Short Class In Scope' =
			VAR AsOfWeekNumber = [As Of Week Number]
			RETURN
			    IF (
			        SELECTEDVALUE ( ClassDay[ShortClass] ) = TRUE ()
			            && SELECTEDVALUE ( ClassDay[WeekNumber] ) <= AsOfWeekNumber,
			        1,
			        0
			    )
		formatString: 0
		displayFolder: Monday
		lineageTag: 6940a871-2eb1-4393-af15-c9d8993aebc0

	measure 'Class Day Track' =
			LOOKUPVALUE (
			    DimTrack[TrackName],
			    DimTrack[TrackKey],
			    SELECTEDVALUE ( ClassDay[TrackKey] )
			)
		displayFolder: Monday
		lineageTag: 12c41737-343d-4892-b695-ee0b2a323b76

	measure 'Story Days Attended' =
			VAR RowWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactAttendance[ClassDate] ),
			        FactAttendance[Attended] = TRUE (),
			        FactAttendance[WeekNumber] = RowWeek
			    )
		formatString: #,0
		displayFolder: Learner story
		lineageTag: 1a2b3c4d-5e6f-4708-91a2-b3c4d5e6f708

	measure 'Story Expected Days' =
			VAR RowWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( ClassDay[ClassDate] ),
			        TREATAS ( VALUES ( DimLearner[CohortKey] ), ClassDay[CohortKey] ),
			        TREATAS ( VALUES ( DimLearner[TrackKey] ), ClassDay[TrackKey] ),
			        ClassDay[WeekNumber] = RowWeek,
			        REMOVEFILTERS ( DimLearner[Email] ),
			        REMOVEFILTERS ( DimLearner[DisplayName] ),
			        REMOVEFILTERS ( DimLearner[NameKey] )
			    )
		formatString: #,0
		displayFolder: Learner story
		lineageTag: 2b3c4d5e-6f70-4819-a2b3-c4d5e6f70819

	measure 'Story Days Participated' =
			VAR RowWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactParticipation[ClassDate] ),
			        FactParticipation[WeekNumber] = RowWeek
			    )
		formatString: #,0
		displayFolder: Learner story
		lineageTag: 3c4d5e6f-7081-492a-b3c4-d5e6f708192a

	measure 'Story Average Lab' =
			VAR RowWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			RETURN
			    CALCULATE (
			        AVERAGE ( FactAssessment[Score] ),
			        FactAssessment[Assessment] = "Lab",
			        FactAssessment[WeekNumber] = RowWeek
			    )
		formatString: 0.0
		displayFolder: Learner story
		lineageTag: 4d5e6f70-8192-4a3b-c4d5-e6f708192a3b

	measure 'Story Average Quiz' =
			VAR RowWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			RETURN
			    CALCULATE (
			        AVERAGE ( FactAssessment[Score] ),
			        FactAssessment[Assessment] = "Quiz",
			        FactAssessment[WeekNumber] = RowWeek
			    )
		formatString: 0.0
		displayFolder: Learner story
		lineageTag: 5e6f7081-92a3-4b4c-d5e6-f708192a3b4c

	measure 'Story Track Quiz' =
			VAR StoryWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			RETURN
			    IF (
			        ISBLANK ( StoryWeek ),
			        BLANK (),
			        CALCULATE (
			            MAX ( TrackWeek[MedianQuiz] ),
			            TREATAS ( VALUES ( DimLearner[CohortKey] ), TrackWeek[CohortKey] ),
			            TREATAS ( VALUES ( DimLearner[TrackKey] ), TrackWeek[TrackKey] ),
			            TrackWeek[WeekNumber] = StoryWeek
			        )
			    )
		formatString: 0.0
		displayFolder: Learner story
		lineageTag: f7a1c2d3-4e56-4789-a012-b3c4d5e6f789

	measure 'Story At Risk' =
			VAR StoryWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			VAR AsOf = [As Of Week Number]
			RETURN
			    IF (
			        ISBLANK ( StoryWeek ) || StoryWeek > AsOf,
			        BLANK (),
			        CALCULATE (
			            [At Risk],
			            AsOfWeek[WeekNumber] = StoryWeek,
			            REMOVEFILTERS ( DimWeek ),
			            REMOVEFILTERS ( WeekWindow )
			        )
			    )
		formatString: 0
		displayFolder: Learner story
		lineageTag: fe3d1d3c-66d8-498c-a423-51d2a0cb642e

	measure 'Story Quiz Against Track' =
			VAR StoryWeek = SELECTEDVALUE ( WeekWindow[WeekNumber] )
			VAR AsOf = [As Of Week Number]
			RETURN
			    IF (
			        ISBLANK ( StoryWeek ) || StoryWeek > AsOf,
			        BLANK (),
			        CALCULATE (
			            [Quiz Against Track],
			            AsOfWeek[WeekNumber] = StoryWeek,
			            REMOVEFILTERS ( DimWeek ),
			            REMOVEFILTERS ( WeekWindow )
			        )
			    )
		formatString: 0.0
		displayFolder: Learner story
		lineageTag: 022ca81b-bdde-45a8-a045-8638f90dea36

	measure 'Story Flag Label' =
			VAR Flag = [Story At Risk]
			RETURN
			    IF (
			        ISBLANK ( Flag ),
			        BLANK (),
			        IF ( Flag = 1, "Flagged", "None" )
			    )
		displayFolder: Learner story
		lineageTag: c3a8e1d4-7b52-4e16-9f20-6d4a1c8b5e77

	measure 'Story Flag Color' =
			VAR Flag = [Story At Risk]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Flag ), BLANK (),
			        Flag = 1, "#F6E4C4",
			        "#D7EFE6"
			    )
		displayFolder: Learner story
		lineageTag: d4b9f2e5-8c63-4f27-a031-7e5b2d9c6f88

	measure 'Story Flag Ink' =
			VAR Flag = [Story At Risk]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Flag ), BLANK (),
			        Flag = 1, "#C4842A",
			        "#1F7A6B"
			    )
		displayFolder: Learner story
		lineageTag: e5c0b3f6-9d74-4038-b142-8f6c3e0d70aa

	measure 'Flagged Weeks' =
			SUMX (
			    WeekWindow,
			    VAR StoryWeek = WeekWindow[WeekNumber]
			    VAR AsOf = [As Of Week Number]
			    RETURN
			        IF (
			            ISBLANK ( StoryWeek ) || StoryWeek > AsOf,
			            BLANK (),
			            CALCULATE (
			                [At Risk],
			                AsOfWeek[WeekNumber] = StoryWeek,
			                REMOVEFILTERS ( DimWeek ),
			                REMOVEFILTERS ( WeekWindow )
			            )
			        )
			)
		formatString: #,0
		displayFolder: Learner story
		lineageTag: e5c0a3f6-9d74-4038-b142-8f6c3e0d7099

	measure 'Calls That Failed' =
			COUNTROWS (
			    FILTER (
			        DimLearner,
			        [First Call Candidate] = 1
			            && CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = FALSE ()
			    )
			)
		formatString: #,0
		displayFolder: Trust
		lineageTag: 4c1a8e20-6b37-4d15-9f44-1a2b3c4d5e61

	measure 'Calls Missed' = [Non-Graduates] - [Calls That Failed]
		formatString: #,0
		displayFolder: Trust
		lineageTag: 5d2b9f31-7c48-4e26-a055-2b3c4d5e6f72

	measure 'Afternoons On Graduates' = [To Call] - [Calls That Failed]
		formatString: #,0
		displayFolder: Trust
		lineageTag: 6e3c0a42-8d59-4f37-b166-3c4d5e6f7083

	measure 'Weeks On Call List' =
			SUMX ( ALL ( AsOfWeek ), IF ( [First Call Candidate] = 1, 1, 0 ) )
		formatString: #,0
		displayFolder: Trust
		lineageTag: 7f4d1b53-9e6a-4048-c277-4d5e6f708194

	measure 'Ever Failed And Called' =
			COUNTROWS (
			    FILTER (
			        DimLearner,
			        CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = FALSE ()
			            && [Weeks On Call List] > 0
			    )
			)
		formatString: #,0
		displayFolder: Trust
		lineageTag: 805e2c64-af7b-4159-d388-5e6f7081a2a5

	measure 'Never Called' =
			IF (
			    CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = FALSE ()
			        && [Weeks On Call List] = 0,
			    1,
			    0
			)
		formatString: 0
		displayFolder: Trust
		lineageTag: 916f3d75-b08c-426a-e499-6f7081a2b3b6

	measure 'Never Called Count' = COUNTROWS ( FILTER ( DimLearner, [Never Called] = 1 ) )
		formatString: #,0
		displayFolder: Trust
		lineageTag: a2704e86-c19d-437b-f5aa-7081a2b3c4c7

	measure 'On Exam List' =
			IF (
			    CALCULATE ( SELECTEDVALUE ( FactOutcome[Graduated] ) ) = TRUE ()
			        && CALCULATE ( SELECTEDVALUE ( FactOutcome[Certified] ) ) = FALSE (),
			    1,
			    0
			)
		formatString: 0
		displayFolder: Trust
		lineageTag: b3815f97-d2ae-448c-a6bb-81a2b3c4d5d8

