table SecurityUsers
	isHidden
	lineageTag: 8d2f0b31-5c74-4e29-9a66-2b3c4d5e6f71

	column UserEmail
		dataType: string
		lineageTag: 9e301c42-6d85-4f30-8b77-3c4d5e6f7082
