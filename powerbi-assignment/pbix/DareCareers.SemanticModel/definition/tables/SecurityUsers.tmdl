	partition SecurityUsers = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SecurityPath), true, true),
				    Sheet = Source{[Item = "Sheet1", Kind = "Sheet"]}[Data],
				    Renamed = Table.RenameColumns(
				        Sheet,
				        List.Transform(Table.ColumnNames(Sheet), each {_, Text.Lower(Text.Trim(_))}),
				        MissingField.Ignore),
				    Keep = Table.SelectColumns(Renamed, {"useremail", "role", "cohortkey", "trackkey"}, MissingField.UseNull),
				    Typed = Table.RenameColumns(Keep, {
				        {"useremail", "UserEmail"}, {"role", "Role"},
				        {"cohortkey", "CohortKey"}, {"trackkey", "TrackKey"}}),
				    Clean = Table.TransformColumns(Typed, {
				        {"UserEmail", each if _ = null then null else Text.Lower(Text.Trim(Text.From(_))), type text},
				        {"Role", each if _ = null then null else Text.Trim(Text.From(_)), type text},
				        {"CohortKey", each if _ = null or Text.Trim(Text.From(_)) = "" then null else Text.Trim(Text.From(_)), type text},
				        {"TrackKey", each if _ = null or Text.Trim(Text.From(_)) = "" then null else Text.Trim(Text.From(_)), type text}})
				in
				    Clean
