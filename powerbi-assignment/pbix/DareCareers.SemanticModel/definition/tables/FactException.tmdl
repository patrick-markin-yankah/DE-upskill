	partition FactException = m
		mode: import
		source =
				let
				    Combined = Table.Combine({exAttendance, exAssessment, exStatus, exLearner, exParticipation}),
				    Cols = {"Feed", "CohortKey", "TrackKey", "ClassDate", "Email", "PersonName", "Detail", "SourceFile"},
				    Present = Table.SelectColumns(Combined, Cols, MissingField.UseNull),
				    Typed = Table.TransformColumns(Present, {
				        {"ClassDate", each if _ = null then null else DateTime.From(_), type datetime}
				    })
				in
				    Typed
